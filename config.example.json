    "whisper_device": "cpu",
    "whisper_compute_type": "int8",

    "_section_transcription": "=== 转写配置 ===",
    "transcription_engine": "auto",
    "language": null,
    "paragraph_merge_gap_sec": 2.0,
    "paragraph_max_chars": 2000,

    "_section_translation": "=== 翻译配置 ===",
